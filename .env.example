# cafe-qr-ai environment. Copy to .env and fill in. Never commit real values.

PORT=8090

# cafe-qr-backend that the tools call (inside docker compose: http://backend:8080)
CAFEQR_BACKEND_URL=http://localhost:8080
# Same value as the backend's JWT_PUBLIC_KEY (Base64 X.509). Leave empty to fetch it from the backend.
CAFEQR_JWT_PUBLIC_KEY=

# Own schema "ai" in the existing PostgreSQL database
AI_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cafeqr_db
AI_DATASOURCE_USERNAME=postgres
AI_DATASOURCE_PASSWORD=

# Browser origins of the owner dashboard (comma separated, wildcards allowed)
AI_ALLOWED_ORIGINS=http://localhost:3000,https://*.cafeqr.in

# ---- AI model for the built-in chat ----
# ollama (free, local; dev/test data only) | anthropic (production) | openai (also OpenAI-compatible APIs)
AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Any OpenAI-compatible API, e.g. Gemini / Groq / OpenRouter. Check the provider does not train on API data.
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com
AI_OPENAI_MODEL=gpt-4o-mini

# ---- limits ----
AI_MONTHLY_QUESTIONS=300
AI_REQUESTS_PER_MINUTE=60
